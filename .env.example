# Demo mode needs no configuration. To use Supabase (see docs/release/RESTORE_SUPABASE.md):
# VITE_BACKEND=supabase
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<public anon key, never the service key>
# VITE_GOOGLE_AUTH=true

# Invite gate for the public demo (server-side only, set in Vercel Production, never VITE_). Unset = gate off.
# See docs/security/DEMO_INVITE_GATE.md
# DEMO_INVITE_CODES=<code1>,<code2>
